// Prisma Schema for Bus Ticketing System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bus {
  id            String    @id @default(uuid())
  busNumber     String    @unique
  model         String
  capacity      Int
  status        String    @default("active") // "active", "maintenance", "inactive"
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  trips         Trip[]
}

model Route {
  id            String    @id @default(uuid())
  name          String    @unique
  fromCity      String
  toCity        String
  distance      Float
  basePrice     Float
  duration      String
  status        String    @default("active") // "active", "inactive"
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  trips         Trip[]
}

model Trip {
  id              String    @id @default(uuid())
  routeId         String
  busId           String
  departureDate   String
  departureTime   String
  arrivalTime     String
  price           Float
  availableSeats  Int
  status          String    @default("scheduled") // "scheduled", "completed", "cancelled"
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  route           Route     @relation(fields: [routeId], references: [id])
  bus             Bus       @relation(fields: [busId], references: [id])
  bookings        Booking[]

  @@index([routeId])
  @@index([busId])
  @@index([departureDate])
  @@unique([routeId, departureDate, departureTime])
  @@unique([busId, departureDate, departureTime])
}

model Booking {
  id              String    @id @default(uuid())
  userId          String
  tripId          String
  seatNumber      String
  passengerName   String
  passengerEmail  String
  passengerPhone  String
  status          String    @default("pending") // "pending", "approved", "complete", "rejected", "cancelled"
  paymentStatus   String    @default("unpaid") // "unpaid", "paid", "refunded"
  paymentMethod   String?   // "GCash", "Maya", "Cash"
  ticketToken     String?   @unique
  checkedInAt     DateTime? @db.Timestamptz(6)
  totalAmount     Float
  bookingDate     DateTime  @default(now()) @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  trip            Trip      @relation(fields: [tripId], references: [id])

  @@index([userId])
  @@index([tripId])
  @@index([status])
}
